{
  "name": "abandoned-cart-recovery-for-woocommerce-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Better Recovery Pro - PHP-only WordPress plugin. npm is used only to package the zip.",
  "scripts": {
    "lint": "composer lint",
    "lint:fix": "composer lint:fix",
    "plugin:prepare": "node scripts/build.cjs",
    "plugin:publish": "npm run plugin:prepare && node scripts/zip.cjs"
  },
  "buildExclude": [
    "node_modules",
    "vendor",
    ".git",
    ".github",
    "*.zip",
    "**/.DS_Store",
    ".gitignore",
    "scripts",
    "docs",
    "composer.lock",
    "package.json",
    "package-lock.json",
    "phpcs.xml.dist",
    "CLAUDE.md",
    ".claude"
  ],
  "devDependencies": {
    "archiver": "^7.0.1",
    "fs-extra": "^11.3.4",
    "micromatch": "^4.0.8"
  }
}
